{
  "name": "d3-wordcloud",
  "version": "1.0.0",
  "description": "A modern D3 word cloud layout with incremental word placement and animation support.",
  "keywords": [
    "d3",
    "d3-module",
    "word",
    "cloud",
    "tag",
    "layout",
    "visualization"
  ],
  "homepage": "https://github.com/sanand0/d3-wordcloud",
  "repository": {
    "type": "git",
    "url": "https://github.com/sanand0/d3-wordcloud.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist/d3-wordcloud.umd.js",
  "module": "dist/d3-wordcloud.js",
  "jsdelivr": "dist/d3-wordcloud.min.js",
  "unpkg": "dist/d3-wordcloud.min.js",
  "exports": {
    ".": {
      "import": "./dist/d3-wordcloud.js",
      "default": "./dist/d3-wordcloud.umd.js"
    },
    "./umd": "./dist/d3-wordcloud.min.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*.js",
    "index.html",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "dependencies": {
    "d3-dispatch": "1 - 3"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^0.4.4",
    "rollup": "^4.0.0"
  },
  "scripts": {
    "build": "rollup -c",
    "test": "node --test",
    "pretest": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  }
}
